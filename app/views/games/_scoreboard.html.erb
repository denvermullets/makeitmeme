<%# Shared Scoreboard list, rendered from a Game::Scoreboard (live Scoreboard now, Recap later). Reads the snapshot only, never Players. %>
<ol>
  <% scoreboard.rows.each do |row| %>
    <li data-nickname="<%= row.nickname %>" data-place="<%= row.place %>" data-reveal-target="row">
      <span><%= row.place %></span>
      <span><%= row.nickname %></span>
      <span><%= row.total %></span>
      <span data-buddies-received><%= row.buddies_received %></span>
      <% if row.memes_of_the_round.positive? %>
        <span data-meme-of-the-round>Meme of the Round<% if row.memes_of_the_round > 1 %> x<span data-count><%= row.memes_of_the_round %></span><% end %></span>
      <% end %>
    </li>
  <% end %>
</ol>
