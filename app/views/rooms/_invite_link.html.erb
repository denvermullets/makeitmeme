<%# The Room's shareable link: opening it asks only for a nickname, then joins. share_controller.js makes the path absolute. %>
<% path = room_path(room.code) %>
<div id="invite_link" class="mt-3" data-controller="share" data-share-url-value="<%= path %>" data-share-title-value="Join my Make It Meme room">
  <p class="text-sm text-muted">Invite link</p>
  <div class="flex items-center gap-2">
    <button type="button" data-action="share#copy" data-share-target="button" class="shrink-0 p-2 leading-none"
            aria-label="Copy invite link" title="Copy invite link">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
      </svg>
    </button>
    <a href="<%= path %>" data-share-target="link" class="underline break-all min-w-0"><%= path %></a>
    <span data-share-target="status" role="status" class="text-sm text-muted shrink-0"></span>
  </div>
</div>
