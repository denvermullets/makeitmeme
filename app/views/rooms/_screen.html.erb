<%# The phase-specific screen. Broadcasts replace #screen as a whole; `player` is nil there. %>
<div id="screen">
  <% if player && (room.captioning? || room.vote?) && room.spectator?(player) %>
    <%= render 'rooms/spectator', room: room %>
  <% elsif room.captioning? %>
    <%= render 'rooms/captioning', room: room, player: player %>
  <% elsif room.vote? %>
    <%= render 'rooms/vote', room: room, player: player %>
  <% elsif room.standings? %>
    <%= render 'rooms/standings', room: room %>
  <% elsif room.scoreboard? %>
    <%= render 'rooms/scoreboard', room: room, player: player %>
  <% else %>
    <%= render 'rooms/waiting', room: room, player: player, errors: local_assigns[:errors] %>
  <% end %>
</div>
