<%# Reveal screen. Bare placeholder: just the Meme. MEME-28 (Reveal and scoring) fills this in. %>
<div id="reveal" data-round="<%= room.current_round_number %>">
  <h2 class="mt-4 font-bold">Round <%= room.current_round_number %>: reveal</h2>
  <%= render 'shared/countdown', deadline: room.phase_deadline_at %>
  <%= image_tag rails_storage_proxy_path(room.current_meme.image), alt: 'The Meme', class: 'w-full mt-2' %>
</div>
