<%# Game-players in order of place; ties share one. `placings` come from Game#placed_game_players.
    Penalties already taken off the total are listed beside it. %>
<ol>
  <% placings.each do |placing| %>
    <% seat = placing.game_player %>
    <li data-nickname="<%= seat.nickname %>">
      <span><%= placing.place %></span>
      <span><%= seat.nickname %><%= render 'players/away_marker', player: seat.player if seat.player %></span>
      <span data-total><%= seat.total %></span>
      <%= render 'games/penalties', missed_votes: seat.missed_votes, unused_buddies: seat.unused_buddies %>
    </li>
  <% end %>
</ol>
