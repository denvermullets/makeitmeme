<div id="waiting">
  <h2 class="mt-6 mb-2 font-bold">Players</h2>
  <ul id="players">
    <%= render partial: 'players/player', collection: room.players.includes(:room).order(:joined_at, :id),
                      locals: { viewer: player } %>
  </ul>

  <%= render 'rooms/captioning_preset', room:, player: %>
  <%= render 'rooms/pack_list', room:, player: %>

  <% if errors&.any? %>
    <ul class="text-danger mt-2">
      <% errors.each do |message| %><li><%= message %></li><% end %>
    </ul>
  <% end %>

  <%= render 'rooms/start_gate', room:, player: %>

  <div class="mt-6 flex items-center justify-between gap-3">
    <%= link_to 'Upload a Template', upload_path(code: room.code), class: 'underline' %>
    <%= button_to 'Leave Room', leave_room_path(room.code) %>
  </div>
</div>
