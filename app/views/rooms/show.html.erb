<main class="p-4 max-w-sm mx-auto">
  <p>Room code</p>
  <p class="text-5xl font-bold tracking-widest" data-room-code><%= @room.code %></p>

  <%# Shared state for everyone in the Room, and a private stream that only this Player is given. %>
  <%= turbo_stream_from @room %>
  <%= turbo_stream_from @room, @player %>

  <%= render 'rooms/screen', room: @room, player: @player, errors: @errors %>
</main>
