<%# The Host's Play again button and why it is disabled, if it is. Re-sent when presence or membership changes. %>
<div id="play_again_gate">
  <% if player && room.host?(player) %>
    <% gate_reason = room.present_players_gate_reason %>
    <%= button_to 'Play again', play_again_room_path(room.code), class: 'border p-2 font-bold mt-4', disabled: !gate_reason.nil? %>
    <% if gate_reason %><p id="play-again-gate-reason" class="mt-2"><%= gate_reason %></p><% end %>
  <% end %>
</div>
