<%# Standings between Rounds: the same for every phone, Spectators included. Ties share a place. %>
<div id="standings" data-round="<%= room.current_round_number %>">
  <h2 class="mt-4 font-bold">Standings after Round <%= room.current_round_number %></h2>
  <%= render 'shared/countdown', deadline: room.phase_deadline_at %>
  <ol>
    <% room.current_game.placed_game_players.each do |game_player| %>
      <li>
        <span><%= game_player.place %></span>
        <span><%= game_player.nickname %><%= render 'players/away_marker', player: game_player.player if game_player.player %></span>
        <span><%= game_player.total %></span>
      </li>
    <% end %>
  </ol>
  <% memes_of_the_round = room.current_game.rounds.find_by(number: room.current_round_number)&.memes_of_the_round&.includes(:game_player) %>
  <% if memes_of_the_round.present? %>
    <div id="meme_of_the_round">
      <h3 class="mt-4 font-bold">Meme of the Round</h3>
      <% memes_of_the_round.each do |meme| %>
        <div>
          <%= image_tag rails_storage_proxy_path(meme.image), alt: 'Meme of the Round', class: 'w-full mt-2' %>
          <p class="mt-2">Made by <strong><%= meme.game_player.nickname %></strong></p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
