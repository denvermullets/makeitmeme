<%# Every Pack with its dealable Template count; the Host turns each on or off. Off Packs are stored on the Room. %>
<div id="pack_list">
  <h2 class="mt-4 font-bold">Packs</h2>
  <% counts = Pack.dealable_counts %>
  <div id="packs">
    <% Pack.alphabetical.each do |pack| %>
      <% on = !room.pack_off?(pack) %>
      <div data-pack="<%= pack.id %>" data-pack-on="<%= on %>">
        <span><%= pack.name %></span>
        <span class="pack-count"><%= counts.fetch(pack.id, 0) %></span>
        <% if player && room.host?(player) %>
          <%= button_to (on ? 'On' : 'Off'), toggle_room_pack_path(room.code, pack, on: on ? 0 : 1),
                        class: 'border px-2' %>
        <% else %>
          <span><%= on ? 'On' : 'Off' %></span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
