<%# Final standings of the finished Game. Ties share a place. %>
<div id="scoreboard">
  <h2 class="mt-4 font-bold">Scoreboard</h2>
  <% game_players = room.current_game.placed_game_players %>
  <ol>
    <% game_players.each do |game_player| %>
      <li>
        <span><%= game_player.place %></span>
        <span><%= game_player.nickname %><%= render 'players/away_marker', player: game_player.player if game_player.player %></span>
        <span><%= game_player.total %></span>
      </li>
    <% end %>
  </ol>

  <%= render 'rooms/pack_list', room:, player: %>

  <%= render 'rooms/play_again_gate', room:, player: %>

  <%= button_to 'Leave Room', leave_room_path(room.code), class: 'border p-2 mt-4' %>
</div>
