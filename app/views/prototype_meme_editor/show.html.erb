<%# PROTOTYPE (MEME-5), throwaway. Three Meme editor variants, switchable via ?variant=A|B|C (and ?seconds=N for the timer). %>
<% content_for :title, "PROTOTYPE Meme editor #{@variant}" %>
<% content_for :head do %>
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Anton&display=block" rel="stylesheet">
<% end %>

<div class="pme"
     data-controller="prototype-meme-editor"
     data-prototype-meme-editor-hand-value="<%= @hand.to_json %>"
     data-prototype-meme-editor-variant-value="<%= @variant %>"
     data-prototype-meme-editor-seconds-value="<%= @seconds %>">
  <div data-prototype-meme-editor-target="root"></div>
  <details class="pme-state">
    <summary>state</summary>
    <pre data-prototype-meme-editor-target="state"></pre>
  </details>
</div>

<div class="proto-switcher" data-controller="prototype-switcher"
     data-prototype-switcher-variants-value='<%= { "A" => "One at a time, inputs inline", "B" => "Grid + type on image", "C" => "Filmstrip, text carries over" }.to_json %>'
     data-prototype-switcher-current-value="<%= @variant %>">
  <button type="button" data-action="prototype-switcher#prev">&larr;</button>
  <span data-prototype-switcher-target="label"></span>
  <button type="button" data-action="prototype-switcher#next">&rarr;</button>
</div>
